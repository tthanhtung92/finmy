// markdownlint-cli2 configuration, the default linter and formatter for Markdown in this repo.
// The PostToolUse hook (.claude/hooks/format-md.sh) runs `markdownlint-cli2 --fix` against it.
// Rule reference: https://github.com/DavidAnson/markdownlint/blob/main/doc/Rules.md
{
  "config": {
    "default": true,

    // MD013 line-length: prose docs are not hard-wrapped to a column, so this is off.
    "MD013": false,

    // MD024 no-duplicate-heading: the same section name can legitimately appear under
    // different parents, so only forbid duplicates among siblings.
    "MD024": { "siblings_only": true },

    // MD033 no-inline-html: allow the few HTML tags that are useful in docs.
    "MD033": { "allowed_elements": ["details", "summary", "br"] },

    // MD060 table-column-style: pipe padding in tables is cosmetic and noisy, so this is off.
    "MD060": false
  },

  // Scope when `markdownlint-cli2` is run manually with no path argument.
  "globs": ["**/*.md"],

  // Skip dependencies, local tooling files, and .NET build output.
  "ignores": ["**/node_modules/**", ".claude/**", "**/bin/**", "**/obj/**"]
}
