<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <!--
    Coverage settings for Microsoft.Testing.Extensions.CodeCoverage, the Microsoft Testing
    Platform collector. This is not a VSTest run settings file: the suite runs on MTP, so
    coverlet and the VSTest collectors do not apply.

    See CLAUDE.md for the command line. Note that a double hyphen cannot appear inside an
    XML comment, so the flags cannot be written out here. It matters more than it looks:
    an invalid comment makes the collector reject the whole file, and it reports that as
    "Zero tests ran" with exit code 5 rather than as a parse error.
  -->
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="Code Coverage">
        <Configuration>
          <CodeCoverage>
            <ModulePaths>
              <!--
                Include is an allowlist: only Finmy's own assemblies are ever considered,
                so a third-party dependency can never inflate the denominator just because
                its PDB happens to be resolvable on a given OS. That is what actually
                happened here: JasperFx (a Wolverine dependency, not Finmy code) was invisible
                to the collector on the Windows dev machine but added 23000+ lines on the
                Linux CI runner the first time this ran there, because the two platforms
                resolve embedded/portable PDBs for the same NuGet package differently.
                Chasing that package by name would only fix this one instance; the allowlist
                fixes the class of bug.
              -->
              <Include>
                <!-- [^\\/]* rather than .*, so this matches only the file name, not any
                     directory segment that happens to contain "Finmy" too. -->
                <ModulePath>.*[\\/]Finmy\.[^\\/]*\.dll$</ModulePath>
              </Include>
              <Exclude>
                <!-- Test assemblies also start with "Finmy.", so the allowlist above does
                     not exclude them on its own. -->
                <ModulePath>.*Tests\.dll$</ModulePath>
              </Exclude>
            </ModulePaths>

            <Sources>
              <Exclude>
                <!--
                  EF scaffolds migrations. Nobody writes that code and nobody tests it.
                  [\\/] rather than \\ alone: this file has to exclude the same paths on
                  the Windows dev machine and the Linux CI runner.
                -->
                <Source>.*[\\/]Migrations[\\/].*</Source>
                <Source>.*[\\/]obj[\\/].*</Source>
              </Exclude>
            </Sources>

            <Functions>
              <Exclude>
                <!-- Composition root, design-time plumbing and Wolverine's generated handler
                     wrappers: exercised by starting the host, not by assertions. -->
                <Function>^Program\..*</Function>
                <Function>.*DesignTimeDbContextFactory.*</Function>
                <Function>^Internal\.Generated\..*</Function>
              </Exclude>
            </Functions>

            <Attributes>
              <Exclude>
                <Attribute>^System\.Diagnostics\.CodeAnalysis\.ExcludeFromCodeCoverageAttribute$</Attribute>
                <Attribute>^System\.CodeDom\.Compiler\.GeneratedCodeAttribute$</Attribute>
              </Exclude>
            </Attributes>

            <CollectFromChildProcesses>true</CollectFromChildProcesses>
          </CodeCoverage>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
